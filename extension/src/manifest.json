{
  "manifest_version": 3,
  "name": "Supermux · Point & tell",
  "description": "Point to an element or circle a detail, then send a private, reviewed screenshot to your coding agent.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "Annotate this page with Supermux", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "commands": {"annotate": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Annotate the current page"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
